// Prisma schema for Anatomical Preparations Website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Preparation {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  imageUrl    String?
  modelUrl    String?
  thumbnailUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
